{
  "name": "@quacklytics/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --bun vite --host 127.0.0.1 --port 3000",
    "build": "bun --bun vite build && bun build src/server/worker.ts --target=bun --packages=external --outfile=dist/backend-worker.js && bun build src/server/exports/worker.ts --target=bun --packages=external --outfile=dist/export-worker.js && bun build src/server/db/migrate-cli.ts --target=bun --packages=external --outfile=dist/migrate.js && rm -rf dist/migrations && cp -R src/server/db/migrations dist/migrations",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun dist/migrate.js",
    "predev": "NODE_ENV=development bun src/server/db/predev.ts"
  },
