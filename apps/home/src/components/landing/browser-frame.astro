---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  url?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const {
  src,
  alt,
  url = "analytics.orbit.example",
  sizes = "(min-width: 1152px) 640px, 100vw",
  priority = false,
  class: className,
} = Astro.props;
---

<figure
  class:list={[
    "overflow-hidden rounded-xl border border-line-strong bg-panel shadow-[0_30px_80px_-20px_rgb(0_0_0/0.8)] ring-1 ring-black/40",
    className,
  ]}
>
  <div class="flex h-9 items-center gap-2 border-b border-line bg-panel-2 px-3.5">
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span
      class="mx-auto hidden max-w-xs flex-1 truncate rounded-md bg-white/5 px-3 py-1 text-center font-mono text-[11px] text-subtle sm:block"
      >{url}</span
    >
    <span class="hidden w-[46px] sm:block"></span>
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[720, 1440, 2160, src.width].filter((width) => width <= src.width)}
    sizes={sizes}
    quality={82}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    class="block h-auto w-full"
  />
</figure>
