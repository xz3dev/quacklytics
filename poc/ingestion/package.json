{
  "name": "quacklytics-ingestion-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/pipeline.test.js",
    "bench": "npm run build && node dist/run.js",
    "smoke": "npm run build && node dist/run.js --events=200 --repeats=1 --batches=100",
    "serve": "npm run build && node dist/server.js",
    "test:bun": "npm run build && bun test ./dist/pipeline.test.js"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.2-r.2",
    "better-sqlite3": "12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.4",
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  }
}
