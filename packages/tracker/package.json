{
  "version": "0.4.0",
  "name": "@quacklytics/client",
  "description": "First-party browser and server analytics client for Quacklytics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz3dev/quacklytics.git",
    "directory": "packages/tracker"
  },
  "homepage": "https://github.com/xz3dev/quacklytics/tree/master/packages/tracker#readme",
  "bugs": {
    "url": "https://github.com/xz3dev/quacklytics/issues"
  },
  "keywords": [
    "analytics",
    "tracking",
    "consent",
    "quacklytics"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./autotrack": {
      "types": "./dist/autotrack.d.ts",
      "import": "./dist/autotrack.js"
    },
    "./consent": {
      "types": "./dist/consent.d.ts",
      "import": "./dist/consent.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build"
  },
  "dependencies": {
    "preact": "11.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "sideEffects": false
}
