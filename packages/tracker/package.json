{
  "name": "@quacklytics/client",
  "version": "0.2.0",
  "description": "First-party browser and server analytics client for Quacklytics.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./autotrack": {
      "types": "./dist/autotrack.d.ts",
      "import": "./dist/autotrack.js"
    },
    "./consent": {
      "types": "./dist/consent.d.ts",
      "import": "./dist/consent.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build"
  },
  "dependencies": {
    "preact": "^10.26.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
